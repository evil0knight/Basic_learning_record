        <mxCell id="cpu-registers" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;" value="&lt;b&gt;Registers（CPU 寄存器：R0~R15、PC、SP 等）&lt;/b&gt;&lt;br&gt;速度最快、数量极少的「工作台」，真正执行加减乘除运算" vertex="1">
          <mxGeometry height="60" width="180" x="640" y="173" as="geometry" />
        </mxCell>
        <mxCell id="startup-title" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;fontStyle=1;align=center;" value="&lt;b&gt;上电启动流程&lt;/b&gt;" vertex="1">
          <mxGeometry height="35" width="550" x="910" y="105" as="geometry" />
        </mxCell>
        <mxCell id="step1-box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bdbdbd;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;" value="" vertex="1">
          <mxGeometry height="70" width="550" x="910" y="150" as="geometry" />
        </mxCell>
        <mxCell id="step1-label" parent="1" style="text;html=1;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;" value="&lt;b&gt;① 硬件复位&lt;/b&gt;" vertex="1">
          <mxGeometry height="20" width="120" x="925" y="153" as="geometry" />
        </mxCell>
        <mxCell id="step1-text" parent="1" style="text;html=1;fontSize=11;fillColor=none;strokeColor=none;align=left;spacingLeft=10;" value="从 &lt;b&gt;0x0000 0000&lt;/b&gt; 读取 MSP 初始值（BOOT 引脚控制映射到 Flash / 系统存储器 / SRAM）→ 加载到 MSP 寄存器&lt;br&gt;从 &lt;b&gt;0x0000 0004&lt;/b&gt; 读取 Reset_Handler 地址(这里运行原装地址或者配置bootloader去选择性下载) → 加载到 PC 寄存器" vertex="1">
          <mxGeometry height="40" width="520" x="925" y="170" as="geometry" />
        </mxCell>
        <mxCell id="arrow-s1-s2" edge="1" parent="1" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#bdbdbd;" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="1185" y="220" as="sourcePoint" />
            <mxPoint x="1185" y="240" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step2-box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bdbdbd;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;" value="" vertex="1">
          <mxGeometry height="50" width="550" x="910" y="240" as="geometry" />
        </mxCell>
        <mxCell id="step2-label" parent="1" style="text;html=1;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;" value="&lt;b&gt;② 执行 Reset_Handler&lt;/b&gt;" vertex="1">
          <mxGeometry height="20" width="220" x="925" y="243" as="geometry" />
        </mxCell>
        <mxCell id="step2-text" parent="1" style="text;html=1;fontSize=11;fillColor=none;strokeColor=none;align=left;spacingLeft=10;" value="调用 &lt;b&gt;SystemInit()&lt;/b&gt;（在 system_stm32xxxxx.c 中，ARM 制定规范，ST 实现）" vertex="1">
          <mxGeometry height="20" width="520" x="925" y="263" as="geometry" />
        </mxCell>
        <mxCell id="arrow-s2-s3" edge="1" parent="1" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#bdbdbd;" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="1185" y="290" as="sourcePoint" />
            <mxPoint x="1185" y="310" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="step3-box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bdbdbd;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;" value="" vertex="1">
          <mxGeometry height="90" width="550" x="910" y="310" as="geometry" />
        </mxCell>
        <mxCell id="step3-label" parent="1" style="text;html=1;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;" value="&lt;b&gt;③ 执行 __main()&lt;/b&gt;" vertex="1">
          <mxGeometry height="20" width="220" x="925" y="313" as="geometry" />
        </mxCell>
        <mxCell id="step3-text" parent="1" style="text;html=1;fontSize=11;fillColor=none;strokeColor=none;align=left;spacingLeft=10;" value="1. 将 Flash 中 &lt;b&gt;.data 段初始值&lt;/b&gt; 复制到 SRAM 的 &lt;b&gt;.data 区&lt;/b&gt;&lt;br&gt;2. 将 SRAM 的 &lt;b&gt;.bss 区清零&lt;/b&gt;&lt;br&gt;3. 完成其他初始化后，&lt;b&gt;调用用户的 main()&lt;/b&gt;" vertex="1">
          <mxGeometry height="60" width="520" x="925" y="330" as="geometry" />
        </mxCell>
        <mxCell id="addr-info" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1e88e5;fontSize=13;fontStyle=1;align=center;verticalAlign=top;verticalLabelPosition=bottom;labelBackgroundColor=#e3f2fd;" value="&lt;b&gt;关键地址&lt;/b&gt;" vertex="1">
          <mxGeometry height="160" width="280" x="910" y="430" as="geometry" />
        </mxCell>
        <mxCell id="addr-text" parent="1" style="text;html=1;fontSize=11;fillColor=none;strokeColor=none;align=left;spacingLeft=8;" value="&lt;b&gt;向量表基址：&lt;/b&gt;0x0000 0000（BOOT 引脚决定映射到哪）&lt;br&gt;&lt;b&gt;  BOOT0=0 → Flash 0x0800 0000&lt;/b&gt;&lt;br&gt;&lt;b&gt;  BOOT0=1 → 系统存储器 0x1FFF 0000&lt;/b&gt;&lt;br&gt;&lt;b&gt;MSP 初值：&lt;/b&gt;0x0000 0000（向量表第 1 项）&lt;br&gt;&lt;b&gt;Reset_Handler：&lt;/b&gt;0x0000 0004（向量表第 2 项）&lt;br&gt;&lt;b&gt;外设寄存器：&lt;/b&gt;0x4000 0000 起&lt;br&gt;&lt;b&gt;系统控制块：&lt;/b&gt;0xE000 E000 起" vertex="1">
          <mxGeometry height="130" width="260" x="920" y="453" as="geometry" />
        </mxCell>
        <mxCell id="address-space-title" parent="1" style="text;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" value="Cortex-M 地址空间" vertex="1">
          <mxGeometry height="30" width="200" x="40" y="40" as="geometry" />
        </mxCell>
        <mxCell id="address-space-system" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE599;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=8;" value="&lt;span style=&quot;color: rgb(255, 51, 51);&quot;&gt;0xFFFF FFFF&lt;/span&gt;&lt;br&gt;片上系统外设 / 供应商保留区&lt;br&gt;&lt;span style=&quot;color: rgb(255, 51, 51);&quot;&gt;0xE010 0000&lt;/span&gt;" vertex="1">
          <mxGeometry height="65" width="200" x="40" y="80" as="geometry" />
        </mxCell>
        <mxCell id="address-space-ppb" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE599;strokeColor=#82b366;fontSize=9;align=left;spacingLeft=8;" value="&lt;span style=&quot;color: rgb(255, 51, 51);&quot;&gt;0xE00F FFFF&lt;/span&gt;&lt;br&gt;PPB 内核私有总线&lt;br&gt;E000 E010：SysTick&lt;br&gt;E000 E100：NVIC&lt;br&gt;E000 ED08：SCB-&amp;gt;VTOR&lt;br&gt;&lt;span style=&quot;color: rgb(255, 51, 51);&quot;&gt;0xE000 0000&lt;/span&gt;" vertex="1">
          <mxGeometry height="105" width="200" x="40" y="155" as="geometry" />
        </mxCell>
        <mxCell id="address-space-external" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE599;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8;" value="&lt;span style=&quot;color: rgb(255, 51, 51); font-size: 9px;&quot;&gt;0xDFFF FFFF&lt;/span&gt;&lt;br&gt;外部 RAM / 外部存储区&lt;br&gt;&lt;span style=&quot;color: rgb(255, 51, 51);&quot;&gt;0x6000 0000&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="200" x="40" y="270" as="geometry" />
        </mxCell>
        <mxCell id="address-space-peripheral" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE599;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=8;" value="&lt;span style=&quot;color: rgb(255, 51, 51);&quot;&gt;0x5FFF FFFF&lt;/span&gt;&lt;br&gt;片上外设：GPIO、USART、TIM、RCC&lt;br&gt;&lt;span style=&quot;color: rgb(255, 51, 51);&quot;&gt;0x4000 0000&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="200" x="40" y="340" as="geometry" />
        </mxCell>
        <mxCell id="address-space-sram" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#66bb6a;fontSize=10;align=left;spacingLeft=8;" value="&lt;span style=&quot;color: rgb(255, 51, 51);&quot;&gt;0x3FFF FFFF&lt;/span&gt;&lt;div&gt;&lt;font&gt;&lt;font color=&quot;#330000&quot;&gt;实际ram空间要看芯片厂给多少(因为成本)&lt;/font&gt;&lt;br&gt;&lt;/font&gt;片内 SRAM：变量、堆、栈&lt;br&gt;&lt;span style=&quot;color: rgb(255, 51, 51);&quot;&gt;0x2000 0000&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="75" width="200" x="40" y="410" as="geometry" />
        </mxCell>
        <mxCell id="address-space-flash" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=8;" value="&lt;font color=&quot;#ff3333&quot;&gt;看厂家给多大的flash&lt;/font&gt;&lt;br&gt;向量表：MSP、Reset、NMI、中断入口&lt;br&gt;代码区：main() 与用户业务代码&lt;br&gt;&lt;span style=&quot;color: rgb(255, 51, 51);&quot;&gt;0x0800 0000&lt;/span&gt;" vertex="1">
          <mxGeometry height="95" width="200" x="40" y="590" as="geometry" />
        </mxCell>
        <mxCell id="address-space-alias" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#1e88e5;fontSize=10;align=left;spacingLeft=8;" value="&lt;span style=&quot;color: rgb(255, 51, 51);&quot;&gt;0x0800 0000&lt;/span&gt;&lt;div&gt;空白区域&lt;br&gt;&lt;span style=&quot;color: rgb(255, 51, 51);&quot;&gt;0x001F FFFF&lt;/span&gt;&lt;div&gt;根据boot0和boot1映射栈顶指针和reset handler中断&lt;br&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(255, 51, 51);&quot;&gt;0x0000 0000&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="95" width="200" x="40" y="700" as="geometry" />
        </mxCell>
