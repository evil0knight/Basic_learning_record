        <mxCell id="flash-text" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;" value="&lt;b&gt;.text（代码段）&lt;/b&gt;&lt;br&gt;机器码，上电后程序在此运行&lt;br&gt;未初始化全局变量以&lt;b&gt;指令方式&lt;/b&gt;存在&lt;br&gt;上电后执行指令开辟 BSS 段" vertex="1">
