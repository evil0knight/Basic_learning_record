        <mxCell id="cpu-registers" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;" value="&lt;b&gt;Cortex-M内核&lt;/b&gt;&lt;div&gt;ALU,寄存器组(R0-R15),&lt;b&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;PPB(内部私有外设总线)&lt;/div&gt;&lt;div&gt;--&amp;gt;NVIC,SysTick,SCB,MPU,DWT...&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
