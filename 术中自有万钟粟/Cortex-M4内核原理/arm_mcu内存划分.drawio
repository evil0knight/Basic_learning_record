        <mxCell id="heap-up-arrow" edge="1" parent="1" source="ram-heap-bg" style="endArrow=open;html=1;strokeWidth=2;strokeColor=#66bb6a;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="ram-stack-bg" value="">
