        </mxCell>
        <mxCell id="latch-node" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bdbdbd;fontSize=12;align=center;" value="硬件在复位上升沿锁存 BOOT0 / BOOT1 引脚" vertex="1">
          <mxGeometry height="38" width="560" x="1200" y="196" as="geometry" />
        </mxCell>
        <mxCell id="boot0-node" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bdbdbd;fontSize=12;align=center;" value="&lt;b&gt;BOOT0 = 0&lt;/b&gt;（默认主 Flash）" vertex="1">
          <mxGeometry height="42" width="420" x="900" y="270" as="geometry" />
        </mxCell>
        <mxCell id="boot1-node" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bdbdbd;fontSize=12;align=center;" value="&lt;b&gt;BOOT0 = 1, BOOT1 = 0&lt;/b&gt;（系统 ROM）" vertex="1">
          <mxGeometry height="42" width="300" x="1360" y="270" as="geometry" />
        </mxCell>
        <mxCell id="boot2-node" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bdbdbd;fontSize=12;align=center;" value="&lt;b&gt;BOOT0 = 1, BOOT1 = 1&lt;/b&gt;（SRAM 运行）" vertex="1">
          <mxGeometry height="42" width="300" x="1700" y="270" as="geometry" />
        </mxCell>
        <mxCell id="map0-node" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bdbdbd;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" value="&lt;b&gt;内存映射:&lt;/b&gt; 0x0800 0000 映射到 0&lt;br&gt;硬件从 Flash 起始地址加载 MSP/PC" vertex="1">
          <mxGeometry height="66" width="420" x="900" y="348" as="geometry" />
        </mxCell>
        <mxCell id="map1-node" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bdbdbd;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" value="&lt;b&gt;内存映射:&lt;/b&gt; 0x1FFF 0000 映射到 0&lt;br&gt;硬件从系统 ROM 加载 MSP/PC" vertex="1">
          <mxGeometry height="66" width="300" x="1360" y="348" as="geometry" />
        </mxCell>
        <mxCell id="map2-node" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bdbdbd;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" value="&lt;b&gt;内存映射:&lt;/b&gt; 0x2000 0000 映射到 0&lt;br&gt;硬件从 SRAM 起始地址加载 MSP/PC" vertex="1">
          <mxGeometry height="66" width="300" x="1700" y="348" as="geometry" />
        </mxCell>
        <mxCell id="app1a-node" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bdbdbd;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" value="&lt;b&gt;【分支 1A：无用户 Bootloader】&lt;/b&gt;&lt;br&gt;&lt;b&gt;0x0800 0000 用户 APP&lt;/b&gt;&lt;br&gt;1. VTOR 默认 0x08000000&lt;br&gt;2. SystemInit()&lt;br&gt;3. __main() 搬移变量&lt;br&gt;4. 执行 APP main() 循环" vertex="1">
          <mxGeometry height="140" width="200" x="900" y="452" as="geometry" />
        </mxCell>
        <mxCell id="bootloader-node" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bdbdbd;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" value="&lt;b&gt;0x0800 0000 为用户自定义 Bootloader&lt;/b&gt;&lt;br&gt;1. 检测升级信号 (Ymodem 串口接收 bin 文件)&lt;br&gt;2. 擦除并重写 0x0800 8000 APP 分区&lt;br&gt;3. 关中断、重置 MSP、跳转至 0x0800 8004" vertex="1">
          <mxGeometry height="170" width="210" x="1110" y="452" as="geometry" />
        </mxCell>
        <mxCell id="app8000-node" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bdbdbd;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" value="&lt;b&gt;0x0800 8000 用户 APP 应用程序&lt;/b&gt;&lt;br&gt;1. SCB-&gt;VTOR = 0x0800 8000 (重定位向量表)&lt;br&gt;2. SystemInit() &amp; __main()&lt;br&gt;3. 执行 APP main() 业务循环" vertex="1">
          <mxGeometry height="130" width="210" x="1110" y="660" as="geometry" />
        </mxCell>
        <mxCell id="rom-node" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bdbdbd;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" value="&lt;b&gt;【芯片出厂只读 Bootloader】&lt;/b&gt;&lt;br&gt;物理位置: 0x1FFF 0000 (ROM)&lt;br&gt;作用: 空片出厂烧录 (ISP 模式)&lt;br&gt;方式: 串口/USB/CAN 接收固件" vertex="1">
          <mxGeometry height="120" width="300" x="1360" y="452" as="geometry" />
        </mxCell>
        <mxCell id="sram-node" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bdbdbd;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" value="&lt;b&gt;【SRAM 内存直接运行模式】&lt;/b&gt;&lt;br&gt;物理位置: 0x2000 0000 (SRAM)&lt;br&gt;1. 代码直接下载到 SRAM&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;(不擦写 Flash，零磨损)&lt;br&gt;2. 向量表设为 0x2000 0000&lt;br&gt;3. 掉电程序立刻丢失&lt;br&gt;4. 专供高速开发断点调试/算法测试" vertex="1">
          <mxGeometry height="160" width="300" x="1700" y="452" as="geometry" />
        </mxCell>
