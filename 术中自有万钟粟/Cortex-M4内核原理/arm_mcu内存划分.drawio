        </mxCell>
        <mxCell id="address-space-flash" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=8;" value="&lt;font color=&quot;#ff3333&quot;&gt;看厂家给多大的flash&lt;/font&gt;&lt;br&gt;向量表：MSP、Reset、NMI、中断入口&lt;br&gt;代码区：main() 与用户业务代码&lt;br&gt;&lt;span style=&quot;color: rgb(255, 51, 51);&quot;&gt;0x0800 0000&lt;/span&gt;" vertex="1">
          <mxGeometry height="95" width="200" x="300" y="1137.5" as="geometry" />
