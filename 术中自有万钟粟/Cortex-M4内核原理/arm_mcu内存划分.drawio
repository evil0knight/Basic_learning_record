        <mxCell id="address-space-title" parent="1" style="text;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" value="Cortex-M 地址空间(逻辑地址)" vertex="1">
          <mxGeometry height="30" width="200" x="50" y="390" as="geometry" />
        </mxCell>
        <mxCell id="address-space-system" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE599;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=8;" value="&lt;span style=&quot;color: rgb(255, 51, 51);&quot;&gt;0xFFFF FFFF&lt;/span&gt;&lt;br&gt;片上系统外设 / 供应商保留区&lt;br&gt;&lt;span style=&quot;color: rgb(255, 51, 51);&quot;&gt;0xE010 0000&lt;/span&gt;" vertex="1">
          <mxGeometry height="65" width="200" x="50" y="430" as="geometry" />
        </mxCell>
        <mxCell id="address-space-ppb" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE599;strokeColor=#82b366;fontSize=9;align=left;spacingLeft=8;" value="&lt;span style=&quot;color: rgb(255, 51, 51);&quot;&gt;0xE00F FFFF&lt;/span&gt;&lt;br&gt;PPB 内核私有总线&lt;br&gt;&lt;span style=&quot;color: rgb(255, 51, 51);&quot;&gt;0xE000 0000&lt;/span&gt;" vertex="1">
          <mxGeometry height="42" width="200" x="50" y="528" as="geometry" />
        </mxCell>
        <mxCell id="address-space-external" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE599;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8;" value="&lt;span style=&quot;color: rgb(255, 51, 51); font-size: 9px;&quot;&gt;0xDFFF FFFF&lt;/span&gt;&lt;br&gt;外部 RAM / 外部存储区&lt;br&gt;&lt;span style=&quot;color: rgb(255, 51, 51);&quot;&gt;0x6000 0000&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="200" x="50" y="620" as="geometry" />
        </mxCell>
        <mxCell id="address-space-peripheral" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE599;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=8;" value="&lt;span style=&quot;color: rgb(255, 51, 51);&quot;&gt;0x5FFF FFFF&lt;/span&gt;&lt;br&gt;片上外设：GPIO、USART、TIM、RCC&lt;br&gt;&lt;span style=&quot;color: rgb(255, 51, 51);&quot;&gt;0x4000 0000&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="200" x="50" y="690" as="geometry" />
        </mxCell>
        <mxCell id="address-space-sram" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#66bb6a;fontSize=10;align=left;spacingLeft=8;" value="&lt;span style=&quot;color: rgb(255, 51, 51);&quot;&gt;0x3FFF FFFF&lt;/span&gt;&lt;div&gt;&lt;font&gt;&lt;font color=&quot;#330000&quot;&gt;实际ram空间要看芯片厂给多少(因为成本)&lt;/font&gt;&lt;br&gt;&lt;/font&gt;片内 SRAM：变量、堆、栈&lt;br&gt;&lt;span style=&quot;color: rgb(255, 51, 51);&quot;&gt;0x2000 0000&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="75" width="200" x="50" y="760" as="geometry" />
        </mxCell>
        <mxCell id="address-space-flash" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=8;" value="&lt;font color=&quot;#ff3333&quot;&gt;看厂家给多大的flash&lt;/font&gt;&lt;br&gt;向量表：MSP、Reset、NMI、中断入口&lt;br&gt;代码区：main() 与用户业务代码&lt;br&gt;&lt;span style=&quot;color: rgb(255, 51, 51);&quot;&gt;0x0800 0000&lt;/span&gt;" vertex="1">
