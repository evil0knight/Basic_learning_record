        <mxCell id="flash-container" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;fontSize=14;verticalAlign=top;verticalLabelPosition=bottom;labelBackgroundColor=#dae8fc;labelBorderColor=#6c8ebf;labelBorderStyle=solid;strokeWidth=2;shadow=0;" value="Flash / ROM（程序代码区）" vertex="1">
