        <mxCell id="boot0-node" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFC4EF;strokeColor=#bdbdbd;fontSize=12;align=center;" value="&lt;b&gt;BOOT0 = 0&lt;/b&gt;（默认主 Flash）" vertex="1">
          <mxGeometry height="42" width="170" x="1085" y="631" as="geometry" />
        </mxCell>
        <mxCell id="D35LznEcIH3lO-CnSRmF-3" edge="1" parent="1" source="boot1-node" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;fontSize=14;fontColor=default;fontStyle=1;labelBorderColor=#82b366;labelBackgroundColor=#d5e8d4;" target="latch-node" value="">
